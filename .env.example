# Firebase Admin SDK (서버 전용 - firebase-admin, lib/firebaseAdmin.ts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 링크 파싱 보강 API (없으면 URL 패턴 추출 결과만 사용, 생략 가능)
KAKAO_REST_API_KEY=
GOOGLE_PLACES_API_KEY=

# 계정 시스템 - 카카오/네이버 로그인(§프롬프트 9 설계안)
# 카카오: 기존 KAKAO_REST_API_KEY 앱에 "카카오 로그인" 상품을 추가로 활성화하고
# Redirect URI({도메인}/api/auth/kakao/callback)를 등록해야 함. 이 키는
# 앱 설정 > 보안의 Client Secret(코드 요청 시 활성화 필요).
KAKAO_CLIENT_SECRET=
# 네이버: 네이버 개발자센터에서 "네이버 아이디로 로그인" 앱을 새로 등록하고
# Callback URL({도메인}/api/auth/naver/callback)을 등록해야 함.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 이메일 로그인(비밀번호 검증)용 Firebase Identity Toolkit REST 호출에 필요.
# 비밀값 아님(Firebase 콘솔 프로젝트 설정 > 일반 > "웹 API 키"에 그냥 노출돼
# 있음) - 그래도 서버 전용 env로만 둬서 클라이언트 번들엔 안 실리게 함.
# Firebase 콘솔에서 이메일/비밀번호 로그인 제공업체도 별도로 활성화해야 함.
FIREBASE_WEB_API_KEY=

# generateMetadata의 metadataBase 등에 사용. dev 서버는 package.json에서
# 3001번 포트로 고정(chemi-map 등 다른 Next 프로젝트가 기본 3000번을 씀)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
