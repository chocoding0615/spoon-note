# Firebase Admin SDK (서버 전용 - firebase-admin, lib/firebaseAdmin.ts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 링크 파싱 보강 API (없으면 URL 패턴 추출 결과만 사용, 생략 가능)
KAKAO_REST_API_KEY=
GOOGLE_PLACES_API_KEY=

# generateMetadata의 metadataBase 등에 사용
NEXT_PUBLIC_SITE_URL=http://localhost:3000
